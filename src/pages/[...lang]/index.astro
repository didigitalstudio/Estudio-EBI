---
// Inicio: portada → servicios → personas y familias → empresas → actualidad → opiniones → preguntas → contacto.
// Quiénes somos tiene su propia página y no aparece en este recorrido.
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Servicios from '../../components/Servicios.astro';
import Personas from '../../components/Personas.astro';
import EmpresasSection from '../../components/EmpresasSection.astro';
import Actualidad from '../../components/Actualidad.astro';
import Opiniones from '../../components/Opiniones.astro';
import Faq from '../../components/Faq.astro';
import Contacto from '../../components/Contacto.astro';
import { DICTS, langPaths, localePath } from '../../i18n/index.js';
import { SITIO } from '../../data/sitio.js';

export const prerender = true;
export const getStaticPaths = langPaths;

const { lang } = Astro.props;
const t = DICTS[lang];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  name: 'Estudio EBI',
  description: t.meta.home.description,
  url: Astro.site ? new URL(localePath(lang, '/'), Astro.site).href : undefined,
  areaServed: { '@type': 'Country', name: 'Argentina' },
  knowsLanguage: ['es', 'en'],
  sameAs: [SITIO.facebook, SITIO.linkedin].filter(Boolean),
};
---
<Base lang={lang} path="/" title={t.meta.home.title} description={t.meta.home.description} jsonLd={jsonLd}>
<Hero
  variant="monument"
  eyebrow={t.hero.place}
  title={t.hero.title}
  accent={t.hero.accent}
  lead={t.hero.lead}
  next="#servicios"
  primary={{ href: '#contacto', label: t.common.consult }}
  links={[
    { href: '#personas', label: t.hero.links.personas },
    { href: '#empresas', label: t.hero.links.empresas },
  ]}
/>
<Servicios lang={lang} />
<Personas lang={lang} />
<EmpresasSection lang={lang} />
<Actualidad lang={lang} />
<Opiniones lang={lang} />
<Faq lang={lang} items={t.faq.items} lead={t.faq.lead} />
<Contacto lang={lang} />
</Base>
