---
// Panel para que los socios publiquen Actualidad Migratoria. Cloudflare Access pide el login antes de
// llegar acá; la API (/api/admin) vuelve a verificarlo en cada pedido.
import '../../styles/site.css';
import es from '../../i18n/es.js';
import { CATEGORIAS } from '../../lib/articulos.js';
import { AUTORES } from '../../data/sitio.js';

export const prerender = true;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Panel · Actualidad Migratoria</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:wght@400;700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
<style is:global>
.adm-top{background:var(--green);color:var(--cream)}
.adm-top-in{max-width:1200px;margin:0 auto;padding:14px 24px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px}
.adm-brand{display:flex;align-items:baseline;gap:12px;color:#fff;text-decoration:none}
.adm-brand b{font-family:'Libre Caslon Text',Georgia,serif;font-size:1.5rem}
.adm-user{font-size:.95rem;color:var(--mist)}
.adm-user a{color:#fff}
.adm{max-width:1200px;margin:0 auto;padding:40px 24px 80px;display:flex;flex-direction:column;gap:24px}
#list-view,#edit-view{display:flex;flex-direction:column;gap:20px}
.adm-bar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px}
.adm h1{font-size:1.75rem}
.adm-msg{padding:14px 18px;border-radius:8px;background:#fff;border:1px solid var(--line)}
.adm-msg.err{border-color:var(--error);color:var(--error)}
.adm-msg.ok{border-color:var(--green);color:var(--green)}
.adm-table{width:100%;border-collapse:collapse;background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden}
.adm-table th,.adm-table td{padding:12px 14px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
.adm-table th{font-size:.8125rem;letter-spacing:.08em;text-transform:uppercase;color:var(--brown);background:var(--paper)}
.adm-table tr:last-child td{border-bottom:0}
.adm-table button{background:none;border:0;padding:0;font:inherit;font-weight:700;color:var(--green);text-align:left;cursor:pointer;text-decoration:underline;text-underline-offset:3px}
.state{display:inline-block;padding:2px 10px;border-radius:999px;font-size:.8125rem;font-weight:700}
.state.publicado{background:#DDEBE3;color:var(--green)}
.state.borrador{background:var(--sand);color:var(--brown)}
.adm-empty{padding:32px;text-align:center;color:var(--muted);background:#fff;border:1.5px dashed var(--line-2);border-radius:12px}
.editor{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:24px;align-items:start}
.ed-form{background:#fff;border:1px solid var(--line);border-radius:12px;padding:24px;display:flex;flex-direction:column;gap:16px}
.ed-form textarea#cuerpo{min-height:420px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.95rem;line-height:1.55}
.ed-help{font-size:.875rem;color:var(--muted)}
.ed-help code{background:var(--paper);padding:1px 5px;border-radius:4px}
.ed-count{font-size:.8125rem;color:var(--muted);text-align:right}
.ed-actions{display:flex;flex-wrap:wrap;gap:10px}
.btn-danger{background:none;border-color:var(--error);color:var(--error)}
.btn-danger:hover{background:var(--error);color:#fff}
.preview{background:#fff;border:1px solid var(--line);border-radius:12px;padding:28px;position:sticky;top:16px;max-height:calc(100vh - 32px);overflow:auto}
.preview-label{font-size:.8125rem;letter-spacing:.12em;text-transform:uppercase;color:var(--brown);margin-bottom:12px}
.preview h2.pv-title{font-size:1.75rem;line-height:1.2;margin-bottom:8px}
.preview .pv-sum{color:var(--muted);font-size:1.125rem;margin-bottom:20px}
@media (max-width:960px){.editor{grid-template-columns:minmax(0,1fr)}.preview{position:static;max-height:none}.adm-table .hide-sm{display:none}}
</style>
</head>
<body>
<header class="adm-top">
<div class="adm-top-in">
<a class="adm-brand" href="/admin"><b>EBI</b><span>Actualidad Migratoria · Panel</span></a>
<p class="adm-user"><span id="user"></span> · <a href="/" target="_blank" rel="noopener">Ver el sitio</a> · <a href="/cdn-cgi/access/logout">Salir</a></p>
</div>
</header>
<main class="adm">
<div id="msg" class="adm-msg" role="status" hidden></div>

<section id="list-view" hidden>
<div class="adm-bar">
<h1>Publicaciones</h1>
<button type="button" class="btn btn-fill" id="new">Nueva publicación</button>
</div>
<div id="list"></div>
</section>

<section id="edit-view" hidden>
<div class="adm-bar">
<h1 id="ed-heading">Nueva publicación</h1>
<button type="button" class="btn btn-out" id="back">← Volver al listado</button>
</div>
<div class="editor">
<form id="ed" class="ed-form" novalidate>
<div class="field">
<label for="titulo">Título</label>
<input id="titulo" name="titulo" type="text" maxlength="200" required>
</div>
<div class="row">
<div class="field">
<label for="categoria">Categoría</label>
<select id="categoria" name="categoria">
{CATEGORIAS.map((c) => <option value={c}>{es.cats[c]}</option>)}
</select>
</div>
<div class="field">
<label for="autor">Autor</label>
<select id="autor" name="autor">
{AUTORES.map((a) => <option value={a}>{a}</option>)}
</select>
</div>
</div>
<div class="field">
<label for="resumen">Resumen <span class="ed-help">(aparece en el listado y al compartir)</span></label>
<textarea id="resumen" name="resumen" rows="3" maxlength="400"></textarea>
<p class="ed-count"><span id="res-count">0</span>/400</p>
</div>
<div class="field">
<label for="cuerpo">Contenido</label>
<textarea id="cuerpo" name="cuerpo"></textarea>
<p class="ed-help">Formato: <code>## Subtítulo</code> · <code>**negrita**</code> · <code>*cursiva*</code> · <code>- punto de lista</code> · <code>[texto del link](https://...)</code> · <code>&gt; cita</code>. Una línea en blanco separa párrafos.</p>
</div>
<div class="field">
<label for="slug">Dirección de la página <span class="ed-help">(opcional, se arma sola con el título)</span></label>
<input id="slug" name="slug" type="text" maxlength="120" placeholder="ej: cambios-residencia-mercosur">
</div>
<div class="ed-actions">
<button type="submit" class="btn btn-fill" value="publicado" id="publish">Publicar</button>
<button type="submit" class="btn btn-out" value="borrador" id="draft">Guardar borrador</button>
<a class="btn btn-out" id="view" href="#" target="_blank" rel="noopener" hidden>Ver publicada</a>
<button type="button" class="btn btn-danger" id="delete" hidden>Eliminar</button>
</div>
</form>
<div class="preview" aria-live="polite">
<p class="preview-label">Vista previa</p>
<h2 class="pv-title" id="pv-title"></h2>
<p class="pv-sum" id="pv-sum"></p>
<div class="prose" id="pv-body"></div>
</div>
</div>
</section>
</main>
<script type="application/json" id="cats" set:html={JSON.stringify(es.cats)} />
<script>
import '../../scripts/admin.js';
</script>
</body>
</html>
