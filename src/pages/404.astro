---
import Base from '../layouts/Base.astro';
export const prerender = true;
---
<Base lang="es" path="/" translated={false} hasContact={false} noindex title="Página no encontrada | Estudio EBI" description="La página que buscás no existe.">
<article class="article">
<h1>No encontramos esta página</h1>
<p class="article-sum">Puede que el link esté incompleto o que la página ya no exista.</p>
<p><a class="btn btn-fill" href="/">Ir al inicio</a></p>
</article>
</Base>
