---
import '../styles/site.css';
import Sprite from '../components/Sprite.astro';
import Flag from '../components/Flag.astro';
import { DICTS, LANGS, langInfo, localePath } from '../i18n/index.js';
import { SITIO } from '../data/sitio.js';

const {
  lang = 'es',
  path = '/',
  translated = true,
  title,
  description,
  hasContact = true,
  noindex = false,
  ogType = 'website',
  jsonLd = null,
} = Astro.props;

const t = DICTS[lang];
const info = langInfo(lang);
const site = Astro.site;
const abs = (p) => (site ? new URL(p, site).href : null);
const canonical = translated ? localePath(lang, path) : Astro.url.pathname;
const home = localePath(lang, '/');
// Servicios, Empresas y Actualidad son secciones del inicio: el script marca la que se está viendo (data-nav).
// key marca la página propia de cada una con aria-current="page".
const nav = [
  { href: `${home}#servicios`, label: t.nav.servicios, sec: 'servicios' },
  { href: `${home}#empresas`, label: t.nav.empresas, sec: 'empresas', key: '/empresas' },
  { href: localePath(lang, '/quienes-somos'), label: t.nav.nosotros, sec: 'nosotros', key: '/quienes-somos' },
  { href: `${home}#actualidad`, label: t.nav.actualidad, sec: 'actualidad', key: '/actualidad' },
];
const contactHref = hasContact ? '#contacto' : `${home}#contacto`;
// Índice del pie: repite el recorrido completo del sitio
const index = [
  { href: `${home}#servicios`, label: t.guide.servicios },
  { href: `${home}#personas`, label: t.guide.personas },
  { href: `${home}#empresas`, label: t.guide.empresas },
  { href: `${home}#actualidad`, label: t.guide.actualidad },
  { href: `${home}#faq`, label: t.guide.faq },
  { href: localePath(lang, '/quienes-somos'), label: t.nav.nosotros },
];
const social = [
  { href: SITIO.facebook, label: 'Facebook', icon: 'i-facebook' },
  { href: SITIO.facebookGrupo, label: t.footer.group, icon: 'i-people' },
  { href: SITIO.linkedin, label: 'LinkedIn', icon: 'i-linkedin-fill' },
].filter((s) => s.href);
const langHref = (code) => localePath(code, translated ? path : '/');
// Textos y datos que usa el script del navegador
const ui = { ...t.ui, cats: t.cats, lang, locale: info.locale, wa: SITIO.whatsapp, menuOpen: t.nav.menuOpen, menuClose: t.nav.menuClose, page: Astro.url.pathname };
---
<!doctype html>
<html lang={info.hreflang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex, nofollow">}
{abs(canonical) && <link rel="canonical" href={abs(canonical)}>}
{site && translated && LANGS.map((l) => <link rel="alternate" hreflang={l.hreflang} href={abs(localePath(l.code, path))}>)}
{site && translated && <link rel="alternate" hreflang="x-default" href={abs(path)}>}
<meta property="og:type" content={ogType}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:locale" content={info.locale.replace('-', '_')}>
<meta property="og:site_name" content="Estudio EBI">
{abs(canonical) && <meta property="og:url" content={abs(canonical)}>}
<meta property="og:image" content={abs('/og.jpg') || '/og.jpg'}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Estudio EBI">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#FAF6EC">
<link rel="icon" type="image/png" sizes="64x64" href="/favicon.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:wght@400;700&family=PT+Serif:wght@400;700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
{SITIO.portada && path === '/' && <link rel="preload" as="image" href={SITIO.portada}>}
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
<slot name="head" />
</head>
<body>
<Sprite />
<header class="top">
<div class="top-in">
<a href={home} class:list={['logo', { 'logo-has-img': SITIO.logo }]} aria-label="Estudio EBI">
{SITIO.logo
  ? <>
    <img src={SITIO.logo} alt="" class="logo-img" width="72" height="72">
    <span class="logo-txt"><span class="logo-name">Estudio EBI</span><span class="logo-tag">{t.nav.brandTag}</span></span>
  </>
  : <>
    <span class="logo-mark">EBI</span>
    <span class="logo-rule"></span>
    <span class="logo-sub">ESTUDIO JURÍDICO</span>
  </>}
</a>
<div class="tools">
<details class="lang-menu">
<summary aria-label={`${t.nav.language}: ${info.name}`}><Flag code={info.flag} /><span class="lang-code">{lang.toUpperCase()}</span><svg class="ic ic-sm" aria-hidden="true"><use href="#i-chevron" /></svg></summary>
<div class="lang-list">
<ul>
{LANGS.map((l) => (
  <li><a href={langHref(l.code)} lang={l.hreflang} hreflang={l.hreflang} aria-current={l.code === lang ? 'true' : undefined}><Flag code={l.flag} />{l.name}</a></li>
))}
</ul>
<button type="button" class="gt-open" data-gt-lang={info.hreflang}><svg class="ic" aria-hidden="true"><use href="#i-globe" /></svg><span>{t.nav.moreLanguages}<small>{t.nav.moreLanguagesNote}</small></span></button>
<div id="gt" class="gt" hidden></div>
</div>
</details>
<button type="button" class="menu-btn" aria-label={t.nav.menuOpen} aria-expanded="false" aria-controls="menu"><svg class="ic ic-lg" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg></button>
</div>
<nav id="menu" class="main-nav" aria-label={t.nav.main}>
{nav.map((n) => <a href={n.href} data-sec={n.sec} aria-current={n.key && n.key === path ? 'page' : undefined}>{n.label}</a>)}
<a href={contactHref} class="nav-cta">{t.nav.consultar}</a>
</nav>
</div>
<div id="guide" class="guide" aria-hidden="true">
<div class="guide-in"><span class="guide-label"></span></div>
<span class="guide-bar"><i></i></span>
</div>
</header>

<main>
<slot />
</main>

<footer class="foot">
<div class="foot-in">
<div class="foot-brand">
<a href={home} class="foot-logo" aria-label="Estudio EBI">{SITIO.logo ? <img src={SITIO.logo} alt="" width="96" height="96" loading="lazy"> : <><b>EBI</b><span>ESTUDIO JURÍDICO</span></>}</a>
<p>{t.footer.tagline}</p>
{social.length > 0 && (
  <div class="foot-social">
    <p class="foot-t">{t.footer.social}</p>
    <ul>
      {social.map((s) => <li><a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}><svg class="ic" aria-hidden="true"><use href={`#${s.icon}`} /></svg></a></li>)}
    </ul>
  </div>
)}
</div>
<nav class="foot-col" aria-label={t.footer.nav}>
<p class="foot-t">{t.footer.sections}</p>
<ul>{index.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
</nav>
<div class="foot-col">
<p class="foot-t">{t.footer.contact}</p>
<ul>
<li><a href={`${home}#contacto`}>{t.footer.formLink}</a></li>
{SITIO.email && <li><a href={`mailto:${SITIO.email}`}>{SITIO.email}</a></li>}
{social.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
</ul>
</div>
</div>
<div class="foot-base">
<p>© {new Date().getFullYear()} Estudio EBI. {t.footer.rights}</p>
</div>
</footer>

<script type="application/json" id="ui" set:html={JSON.stringify(ui).replace(/</g, '\\u003c')} />
<script>
import '../scripts/site.js';
</script>
</body>
</html>
