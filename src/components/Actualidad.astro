---
// Actualidad en el inicio: las tres publicaciones más recientes del estudio (las trae el script de
// /api/articulos, así una nota nueva aparece sola) y, debajo, la normativa migratoria con enlaces a la
// fuente oficial (/api/normas). Las noticias de medios quedan solo en la página de Actualidad.
import { DICTS } from '../i18n/index.js';
const { lang } = Astro.props;
const t = DICTS[lang];
const a = t.actualidad;
const es = lang === 'es' ? undefined : 'es';
---
<section id="actualidad" data-guide={t.guide.actualidad} data-nav="actualidad">
<div class="wrap stack">
<div class="act-head">
<div class="head">
<p class="eyebrow">{a.eyebrow}</p>
<h2 class="h2">{a.title}</h2>
<p class="lead">{a.lead}</p>
<a href="/actualidad" class="btn btn-out" hreflang={es}>{a.all}</a>
</div>
<div class="act-pics" aria-hidden="true">
<img class="act-pic act-pic-a" src="/img/aeropuerto.webp" alt="" width="1200" height="900" loading="lazy" decoding="async">
<img class="act-pic act-pic-b" src="/img/frontera.webp" alt="" width="1200" height="900" loading="lazy" decoding="async">
</div>
</div>
<div id="pub-grid" class="pub-grid" aria-live="polite" data-empty={a.empty}>
<div class="skel" aria-hidden="true"></div><div class="skel" aria-hidden="true"></div><div class="skel" aria-hidden="true"></div>
</div>
<div class="norm-box">
<div class="norm-head">
<span class="ico-badge"><svg class="ic" aria-hidden="true"><use href="#i-book" /></svg></span>
<div>
<h3 class="norm-title">{a.normativa}</h3>
<p class="norm-text">{a.normativaText}</p>
</div>
<a href="/actualidad#normativa" class="norm-all" hreflang={es}>{a.normativaAll}<svg class="ic ic-sm" aria-hidden="true"><use href="#i-arrow" /></svg></a>
</div>
<ul id="norm-list" class="norm-list" data-see={a.normativaSee} hidden></ul>
</div>
</div>
</section>
