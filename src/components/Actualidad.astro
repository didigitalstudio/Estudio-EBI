---
// Actualidad en el inicio: carrusel con las publicaciones del estudio y las noticias de medios
// (lo arma el script), y accesos a todas las publicaciones y al repositorio jurídico.
import { DICTS } from '../i18n/index.js';
const { lang } = Astro.props;
const t = DICTS[lang];
const a = t.actualidad;
---
<section id="actualidad" data-guide={t.guide.actualidad} data-nav="actualidad">
<div class="wrap stack">
<div class="act-head">
<div class="head">
<p class="eyebrow">{a.eyebrow}</p>
<h2 class="h2">{a.title}</h2>
<p class="lead">{a.lead}</p>
</div>
<div class="car-ctrl">
<button type="button" class="car-btn" data-car="prev" aria-label={a.prev}><svg class="ic" aria-hidden="true"><use href="#i-left" /></svg></button>
<button type="button" class="car-btn" data-car="next" aria-label={a.next}><svg class="ic" aria-hidden="true"><use href="#i-arrow" /></svg></button>
</div>
</div>
<div class="carousel" role="region" aria-roledescription="carousel" aria-label={a.carousel}>
<div id="news-track" class="car-track" tabindex="0" aria-live="polite">
<div class="skel" aria-hidden="true"></div><div class="skel" aria-hidden="true"></div><div class="skel" aria-hidden="true"></div>
</div>
</div>
<div class="act-foot">
<a href="/actualidad" class="btn btn-out" hreflang={lang === 'es' ? undefined : 'es'}>{a.all}</a>
<a href="/actualidad#repositorio" class="repo-link" hreflang={lang === 'es' ? undefined : 'es'}>
<span class="ico-badge"><svg class="ic" aria-hidden="true"><use href="#i-book" /></svg></span>
<span><strong>{a.repositorio}</strong><span>{a.repositorioText}</span></span>
</a>
</div>
<p class="note"><span>{a.note}</span> <a href="https://www.argentina.gob.ar/interior/migraciones" target="_blank" rel="noopener">argentina.gob.ar/migraciones</a>.</p>
</div>
</section>
