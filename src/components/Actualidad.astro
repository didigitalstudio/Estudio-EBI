---
import { DICTS } from '../i18n/index.js';
const { lang, band = false } = Astro.props;
const t = DICTS[lang].actualidad;
---
<section id="actualidad" class={band ? 'band' : undefined}>
<div class="wrap stack">
<div class="head">
<p class="eyebrow">{t.eyebrow}</p>
<h2 class="h2">{t.title}</h2>
<p class="lead">{t.lead}</p>
</div>
<div id="studio" class="studio" hidden>
<div class="sub-head"><h3>{t.studio}</h3><a href="/actualidad" class="more-link">{t.all} →</a></div>
<div id="studio-list" class="art-list"></div>
</div>
<div class="media">
<h3 class="sub-title">{t.media}</h3>
<div id="news-list" class="pubs" aria-live="polite">
<div class="skel" aria-hidden="true"></div><div class="skel" aria-hidden="true"></div><div class="skel" aria-hidden="true"></div><div class="skel" aria-hidden="true"></div>
</div>
</div>
<p class="note"><span>{t.note}</span> <a href="https://www.argentina.gob.ar/interior/migraciones" target="_blank" rel="noopener">argentina.gob.ar/migraciones</a>.</p>
</div>
</section>
