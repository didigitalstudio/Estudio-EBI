---
// Encabezado de cada página: texto a la izquierda y un panel verde a la derecha (slot).
const { eyebrow, title, lead, primary, wa, trust = [] } = Astro.props;
const trustIcons = ['i-shield', 'i-screen', 'i-pin'];
---
<section class="hero">
<div class="wrap hero-in">
<div class="hero-copy">
<p class="eyebrow">{eyebrow}</p>
<h1>{title}</h1>
<p class="hero-lead">{lead}</p>
<div class="ctas">
<a href={primary.href} class="btn btn-fill" data-perfil={primary.perfil} data-tipo={primary.tipo}>{primary.label}</a>
<a href={wa.href} class="btn btn-out"><svg class="ic" aria-hidden="true"><use href="#i-chat" /></svg><span>{wa.label}</span></a>
</div>
{trust.length > 0 && (
  <ul class="trust">
    {trust.map((txt, i) => <li><svg class="ic" aria-hidden="true"><use href={`#${trustIcons[i]}`} /></svg><span>{txt}</span></li>)}
  </ul>
)}
</div>
<div class="panel">
<svg class="panel-art" width="400" height="120" viewBox="0 0 400 120" fill="none" aria-hidden="true">
<path d="M20 100 Q 110 10 200 70" stroke="#C9A86B" stroke-width="1.5" />
<path d="M200 70 Q 290 0 380 40" stroke="#C9A86B" stroke-width="1.5" />
<path d="M60 110 Q 200 -10 340 90" stroke="#C9A86B" stroke-width="1" opacity="0.6" />
<circle cx="20" cy="100" r="4" fill="#C9A86B" />
<circle cx="200" cy="70" r="4" fill="#C9A86B" />
<circle cx="380" cy="40" r="4" fill="#C9A86B" />
<circle cx="60" cy="110" r="3" fill="#C9A86B" />
<circle cx="340" cy="90" r="3" fill="#C9A86B" />
</svg>
<slot />
</div>
</div>
</section>
