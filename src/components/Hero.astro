---
// Portada de cada página: foto de la ciudad difusa de fondo (o la silueta, hasta que se elija la foto),
// título, bajada y accesos. El slot opcional va en una tarjeta a la derecha (ej. la lista de empresas).
import Skyline from './Skyline.astro';
import { SITIO } from '../data/sitio.js';

const { eyebrow = '', title, lead, primary, links = [], size = 'lg' } = Astro.props;
const hasPanel = Astro.slots.has('default');
---
<section class:list={['hero', `hero-${size}`]}>
{SITIO.portada ? <div class="hero-bg" style={`background-image:url('${SITIO.portada}')`}></div> : <Skyline />}
<div class:list={['wrap hero-in', { 'has-panel': hasPanel }]}>
<div class="hero-copy">
{eyebrow && <p class="eyebrow">{eyebrow}</p>}
<h1>{title}</h1>
<p class="hero-lead">{lead}</p>
{(primary || links.length > 0) && (
  <div class="ctas">
    {primary && <a href={primary.href} class="btn btn-light" data-perfil={primary.perfil} data-tipo={primary.tipo}>{primary.label}</a>}
    {links.map((l) => <a href={l.href} class="btn btn-ghost">{l.label}<svg class="ic ic-sm" aria-hidden="true"><use href="#i-arrow" /></svg></a>)}
  </div>
)}
</div>
{hasPanel && <div class="panel"><slot /></div>}
</div>
</section>
