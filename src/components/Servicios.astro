---
import { DICTS } from '../i18n/index.js';
const { lang } = Astro.props;
const t = DICTS[lang].servicios;
---
<section id="servicios" class="band" data-guide={DICTS[lang].guide.servicios} data-nav="servicios">
<div class="wrap stack">
<div class="head">
<p class="eyebrow">{t.eyebrow}</p>
<h2 class="h2">{t.title}</h2>
<p class="lead">{t.lead}</p>
</div>
<div class="areas">
{t.areas.map((a, i) => (
  <article class="area">
    <span class="area-n">{String(i + 1).padStart(2, '0')}</span>
    <h3>{a.title}</h3>
    <p>{a.text}</p>
    <ul class="list">{a.items.map((it) => <li>{it}</li>)}</ul>
  </article>
))}
</div>
</div>
</section>
