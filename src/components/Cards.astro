---
// Bloque de tres tarjetas con lista (subpáginas)
const { eyebrow, title, lead, items, icons = [] } = Astro.props;
---
<section class="band">
<div class="wrap stack">
<div class="head">
<p class="eyebrow">{eyebrow}</p>
<h2 class="h2">{title}</h2>
<p class="lead">{lead}</p>
</div>
<div class="grid-3">
{items.map((c, i) => (
  <article class="card">
    <span class="ico-badge"><svg class="ic" aria-hidden="true"><use href={`#${icons[i] || 'i-check'}`} /></svg></span>
    <h3>{c.title}</h3>
    <ul class="list">{c.items.map((it) => <li>{it}</li>)}</ul>
  </article>
))}
</div>
<slot />
</div>
</section>
