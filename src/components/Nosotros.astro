---
import { DICTS } from '../i18n/index.js';
import { SOCIOS } from '../data/sitio.js';
const { lang } = Astro.props;
const t = DICTS[lang].nosotros;
const modeIcons = ['i-people', 'i-chat', 'i-person', 'i-globe'];
const apellido = (nombre) => nombre.split(' ').at(-1);
---
<section id="nosotros">
<div class="wrap stack">
<div class="about">
<div class="about-copy">
<p class="eyebrow">{t.eyebrow}</p>
<h2 class="h2">{t.title}</h2>
<p class="lead">{t.lead}</p>
<ul class="checks">
{t.checks.map((c) => <li><svg class="ic" aria-hidden="true"><use href="#i-check" /></svg><span>{c}</span></li>)}
</ul>
</div>
<div class="name-card">
<p class="name-title">{t.nameTitle}</p>
<div class="initials" aria-hidden="true">
{SOCIOS.map((s) => <div><span class="initial">{s.inicial}</span><span class="surname">{apellido(s.nombre)}</span></div>)}
</div>
<p class="name-text">{t.nameText}</p>
</div>
</div>
<div class="team">
{SOCIOS.map((s) => (
  <article class="person">
    {s.foto ? <img class="photo" src={s.foto} alt={s.nombre} loading="lazy" /> : <div class="photo">{t.photo}</div>}
    <div class="person-head">
      <h3>{s.nombre}</h3>
      <p class="person-role">{s.socia ? t.partner : t.partnerM}</p>
    </div>
    <p class="person-bio">{t.socios[s.id]}</p>
    <p class="person-cred">{t.credentials}</p>
    {s.linkedin && <a class="person-link" href={s.linkedin} target="_blank" rel="noopener"><svg class="ic" aria-hidden="true"><use href="#i-linkedin" /></svg>{t.linkedin}</a>}
  </article>
))}
</div>
<h3 class="modes-title">{t.modesTitle}</h3>
<div class="modes">
{t.modes.map((m, i) => (
  <div class="mode">
    <span class="ico-badge"><svg class="ic" aria-hidden="true"><use href={`#${modeIcons[i]}`} /></svg></span>
    <div><p class="mode-t">{m.title}</p><p class="mode-d">{m.text}</p></div>
  </div>
))}
</div>
</div>
</section>
