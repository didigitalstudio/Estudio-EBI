---
// Quiénes somos: presentación del estudio, experiencia del equipo y enfoque. Solo apellidos, sin fotos ni
// currículums (pedido del estudio). Tiene su propia página, no aparece en el recorrido del inicio.
import { DICTS } from '../i18n/index.js';
import { rich } from '../lib/rich.js';

const { lang } = Astro.props;
const t = DICTS[lang];
const n = t.nosotros;
const expIcons = ['i-scale', 'i-inst', 'i-globe'];
const modeIcons = ['i-people', 'i-chat', 'i-person', 'i-globe'];
---
<section id="nosotros" data-guide={t.guide.nosotros} data-nav="nosotros">
<div class="wrap stack">
<div class="about">
<p class="resena" set:html={rich(n.body[0])} />
<div class="about-more">{n.body.slice(1).map((p) => <p set:html={rich(p)} />)}</div>
</div>
<div class="exp">
<h2 class="h3">{n.expTitle}</h2>
<div class="grid-3">
{n.exp.map((e, i) => (
  <article class="pillar">
    <span class="ico-badge"><svg class="ic" aria-hidden="true"><use href={`#${expIcons[i]}`} /></svg></span>
    <h3>{e.title}</h3>
    <p>{e.text}</p>
  </article>
))}
</div>
</div>
<div class="enfoque">
<p class="eyebrow">{n.enfoqueTitle}</p>
<p class="enfoque-t" set:html={rich(n.enfoque)} />
</div>
</div>
</section>
<section class="band" data-guide={n.modesTitle}>
<div class="wrap stack">
<div class="head">
<h2 class="h3">{n.modesTitle}</h2>
<p class="lead">{n.modesLead}</p>
</div>
<div class="modes">
{n.modes.map((m, i) => (
  <div class="mode">
    <span class="ico-badge"><svg class="ic" aria-hidden="true"><use href={`#${modeIcons[i]}`} /></svg></span>
    <div><p class="mode-t">{m.title}</p><p class="mode-d">{m.text}</p></div>
  </div>
))}
</div>
</div>
</section>
