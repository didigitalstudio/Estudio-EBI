---
// Subpágina /empresas para campañas: misma información que la sección del inicio, con portada propia,
// por qué EBI y preguntas para empresas.
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import EmpresasSection from './EmpresasSection.astro';
import Why from './Why.astro';
import Faq from './Faq.astro';
import Contacto from './Contacto.astro';
import { DICTS, localePath } from '../i18n/index.js';

const { lang } = Astro.props;
const t = DICTS[lang];
const p = t.pages.empresas;
---
<Base lang={lang} path="/empresas" title={t.meta.empresas.title} description={t.meta.empresas.description}>
<Hero
  eyebrow={p.hero.eyebrow}
  title={p.hero.title}
  lead={p.hero.lead}
  primary={{ href: '#contacto', label: t.common.proposal, perfil: 'empresa', tipo: 'renure' }}
  links={[{ href: `${localePath(lang, '/')}#servicios`, label: t.nav.servicios }]}
>
<p class="panel-title">{t.common.solves}</p>
<ul class="panel-list">
{p.hero.bullets.map((b) => <li><svg class="ic" aria-hidden="true"><use href="#i-check" /></svg><span>{b}</span></li>)}
</ul>
</Hero>
<EmpresasSection lang={lang} intro={false} />
<Why lang={lang} />
<Faq lang={lang} items={p.faq} />
<Contacto lang={lang} perfil="empresa" tipo="renure" />
</Base>
