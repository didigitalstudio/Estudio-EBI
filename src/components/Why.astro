---
import { DICTS } from '../i18n/index.js';
const { lang, band = false } = Astro.props;
const t = DICTS[lang].why;
const icons = ['i-inst', 'i-globe', 'i-scale'];
---
<section id="por-que" class={band ? 'band' : undefined}>
<div class="wrap stack">
<div class="head">
<p class="eyebrow">{t.eyebrow}</p>
<h2 class="h2">{t.title}</h2>
<p class="lead">{t.lead}</p>
</div>
<div class="grid-3">
{t.items.map((it, i) => (
  <article class="pillar">
    <span class="ico-badge"><svg class="ic" aria-hidden="true"><use href={`#${icons[i]}`} /></svg></span>
    <h3>{it.title}</h3>
    <p>{it.text}</p>
  </article>
))}
</div>
<p class="rights"><svg class="ic" aria-hidden="true"><use href="#i-shield" /></svg><span>{t.rights}</span></p>
</div>
</section>
