    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.3",
    "astro": "7.3.5",
    "marked": "18.0.14"
  },
  "devDependencies": {
    "wrangler": "4.142.0"
  }
}
