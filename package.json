{
  "name": "estudio-ebi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test --disable-warning=ExperimentalWarning test/*.test.js",
    "db:migrate:local": "wrangler d1 migrations apply ebi --local",
